// TSConfig for the Playwright end-to-end sources under e2e/.
//
// WHY THIS FILE EXISTS: tsconfig.app.json only includes `env.d.ts` and
// `src/**`, and tsconfig.node.json only includes the *.config.* files, so
// nothing under e2e/ belonged to any tsconfig project. Those 11 files were
// type-checked by nothing. They are clean today (0 errors) — this project
// keeps them that way rather than fixing anything.
//
// playwright.config.ts is deliberately NOT listed here: it is already
// covered by tsconfig.node.json, and listing a file in two projects makes
// it ambiguous which one owns it.
{
  "extends": "./tsconfig.app.json",
  "include": ["e2e/**/*.ts"],
  "exclude": [],
  "compilerOptions": {
    // The e2e specs read process.env (E2E_BASE_URL / E2E_EMAIL /
    // E2E_PASSWORD) and use node path helpers for snapshot paths.
    "types": ["node"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental
    // type-checking. Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
